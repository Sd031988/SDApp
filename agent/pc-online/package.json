{
  "name": "sd-lotze-online",
  "version": "1.0.0",
  "private": true,
  "description": "SD Lotze: aktuelle Online-Funktionen in einer sicheren Desktop-Hülle",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.thesdhub.sdlotze.online",
    "productName": "SD Lotze Online",
    "asar": true,
    "files": [
      "main.cjs",
      "url-policy.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sd031988",
        "repo": "SDApp"
      }
    ]
  },
  "author": {
    "name": "The SD Hub",
    "email": "kontakt@thesdhub.com"
  },
  "homepage": "https://www.thesdhub.com/agent/index.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sd031988/SDApp.git"
  }
}
