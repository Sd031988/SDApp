rules_version = '2';
// SD Suite – Firestore: jede Person sieht und ändert NUR ihre eigenen Daten unter users/{uid}/…
// Alles andere ist gesperrt (auch für nicht angemeldete Besucher).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.size() <= 200;
    }
    // Rückmeldungen (Feedback) schreibt und liest nur der Server mit dem Admin-SDK.
    // Browser haben keinen Zugriff, auch nicht angemeldete Nutzer oder Admins.
    match /feedbackPrivate/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
